<Window x:Class="Alunos.EditarPerfil"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Perfil"
        Height="500" Width="700"
        Background="#F0F2F5"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Estilo de botão arredondado moderno -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#143d67"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="25" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de caixa de texto com rótulo no topo -->
        <Style x:Key="LabelTextBoxStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- "Cartão" central com sombra -->
        <Border Background="White" CornerRadius="15" Width="600" Height="380"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="30" 
               >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Foto no Canvas como pediste -->
                <Canvas x:Name="CanvasCarregar" Width="120" Height="120"
                        Margin="25,40,0,0"
                        Grid.Column="0"
                        VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Canvas.Background>
                        <ImageBrush/>
                    </Canvas.Background>
                </Canvas>

                <!-- Formulário -->
                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="10,0,0,0">
                    <TextBlock Text="Editar Perfil" FontSize="22" FontWeight="Bold" Foreground="#143d67" Margin="0,0,0,20"/>

                    <!-- Campo Nome -->
                    <StackPanel Style="{StaticResource LabelTextBoxStyle}">
                        <TextBlock Text="Nome" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="TbNome" Height="30" FontSize="14"/>
                    </StackPanel>

                    <!-- Campo Email -->
                    <StackPanel Style="{StaticResource LabelTextBoxStyle}">
                        <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="tbEmail" Height="30" FontSize="14"/>
                    </StackPanel>

                    <!-- Botão Carregar -->

                    <!-- Ações -->
                    <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                        <Button x:Name="btnSalvar" Content="Guardar" Style="{StaticResource RoundedButtonStyle}"
                                Width="156" Click="btnSalvar_Click" Margin="0,0,10,0"/>
                        <Button x:Name="btnCancelar" Content="Cancelar" Style="{StaticResource RoundedButtonStyle}"
                                Background="#777" Width="175" Click="btnCancelar_Click"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="btnCarregar" Content="Carregar Foto"
                            Style="{StaticResource RoundedButtonStyle}" Margin="10,197,20,83"
                            Click="btnCarregar_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
