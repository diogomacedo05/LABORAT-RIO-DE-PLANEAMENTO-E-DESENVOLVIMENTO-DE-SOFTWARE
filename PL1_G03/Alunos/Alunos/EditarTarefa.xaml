<Window x:Class="Alunos.EditarTarefa"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Editar Tarefa"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Estilos reutilizados -->
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderBrush" Value="#ccc"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#ccc"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Background" Value="#143d67"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="80">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <TextBlock Text="Editar Tarefa"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#143d67"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <!-- Formulário -->
            <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="50"
                    >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Título -->
                    <Label Content="Título:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox x:Name="tbTitulo" Grid.Row="0" Grid.Column="1"/>

                    <!-- Descrição -->
                    <Label Content="Descrição:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox x:Name="tbDescricao" Grid.Row="1" Grid.Column="1" Height="80" TextWrapping="Wrap"/>

                    <!-- Peso -->
                    <Label Content="Peso:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox x:Name="tbPeso" Grid.Row="2" Grid.Column="1"/>

                    <!-- Data de Início -->
                    <Label Content="Data de Início:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                    <xctk:DateTimePicker x:Name="dateTimePickerInicio"
                                         Grid.Row="3" Grid.Column="1"
                                         Format="Custom"
                                         FormatString="dd/MM/yyyy HH:mm"
                                         Height="40"
                                         FontSize="16"
                                         BorderBrush="#ccc"
                                         BorderThickness="1"
                                         Background="White"
                                         Margin="0,6"/>

                    <!-- Data de Término -->
                    <Label Content="Data de Término:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
                    <xctk:DateTimePicker x:Name="dateTimePickerTermino"
                                         Grid.Row="4" Grid.Column="1"
                                         Format="Custom"
                                         FormatString="dd/MM/yyyy HH:mm"
                                         Height="40"
                                         FontSize="16"
                                         BorderBrush="#ccc"
                                         BorderThickness="1"
                                         Background="White"
                                         Margin="0,6"/>
                </Grid>
            </Border>

            <!-- Botões -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,40,0,0">
                <Button x:Name="btnVoltar"
                        Content="Voltar"
                        Style="{StaticResource ModernButtonStyle}"
                        Click="btnVoltar_Click"/>

                <Button x:Name="btnSalvar"
                        Content="Guardar"
                        Style="{StaticResource ModernButtonStyle}"
                        Click="btnSalvar_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
