<Window x:Class="Alunos.ListaTarefas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Alunos"
        ResizeMode="CanResize"
        WindowState="Maximized"
        mc:Ignorable="d"
        Title="ListaTarefas" Height="400" Width="600" SizeChanged="Window_SizeChanged">

    <Grid>
        <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" 
                   Text="Lista de Tarefas" VerticalAlignment="Top" 
                   FontSize="24" FontWeight="Bold"/>

        <!-- ListView com visual moderno -->
        <Border Background="White" CornerRadius="12" Padding="20" Margin="20,50,20,80">
            <ListView x:Name="lvTarefas"
                      ItemsSource="{Binding Tarefas}"
                      HorizontalAlignment="Stretch"
                      Background="White"
                      BorderThickness="0"
                      AlternationCount="2">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Height" Value="36"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#F0F2F5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Tipo" DisplayMemberBinding="{Binding TipoTarefa}" Width="70"/>
                        <GridViewColumn Header="Título" DisplayMemberBinding="{Binding Titulo}" Width="100"/>
                        <GridViewColumn Header="Descrição" DisplayMemberBinding="{Binding Descricao}" Width="160"/>
                        <GridViewColumn Header="Peso" DisplayMemberBinding="{Binding Peso}" Width="50"/>
                        <GridViewColumn Header="Início" DisplayMemberBinding="{Binding DataInicio}" Width="90"/>
                        <GridViewColumn Header="Término" DisplayMemberBinding="{Binding DataTermino}" Width="90"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
            <Button x:Name="btnCriarTarefa" Content="Criar Tarefa" Style="{StaticResource RoundedButtonStyle}"
                    Width="121" Margin="10" Click="btnCriarTarefa_Click_1" Height="31"/>
            <Button x:Name="btnEditarTarefa" Content="Editar Tarefa" Style="{StaticResource RoundedButtonStyle}"
                    Width="120" Margin="10" Click="btnEditarTarefa_Click_1"/>
            <Button x:Name="btnEliminarTarefa"  Content="Eliminar Tarefa" Background="#b91c1c" Style="{StaticResource RoundedButtonStyle}"
                    Width="120" Margin="10" Click="btnEliminarTarefa_Click_1"/>
            <Button x:Name="btnVoltar" Content="Voltar" Style="{StaticResource RoundedButtonStyle}"
                    Width="120" Margin="10" Click="btnVoltar_Click_1"/>
        </StackPanel>
    </Grid>
</Window>
