<Window x:Class="Alunos.EditarAluno"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ResizeMode="NoResize"
        WindowState="Normal"
        Title="Editar Aluno" Height="300" Width="400">
    <Grid>
        <!-- Número -->
        <Label Content="Número:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="50,20,0,0" />
        <TextBox x:Name="TbNumero" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" Margin="150,20,0,0" />

        <!-- Nome -->
        <Label Content="Nome:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="50,60,0,0" />
        <TextBox x:Name="TbNome" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" Margin="150,60,0,0" />

        <!-- Email -->
        <Label Content="Email:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="50,100,0,0" />
        <TextBox x:Name="TbEmail" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" Margin="150,100,0,0" />

        <!-- Botão Salvar -->
        <Button Content="Guardar"
                HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" Height="40" Margin="50,160,0,0"
                Background="#143d67" Foreground="White" FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                Click="btnSalvar_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="20" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

        <!-- Botão Cancelar -->
        <Button Content="Cancelar"
                HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" Height="40" Margin="200,160,0,0"
                Background="#b91c1c" Foreground="White" FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                Click="btnCancelar_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="20" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

    </Grid>
</Window>