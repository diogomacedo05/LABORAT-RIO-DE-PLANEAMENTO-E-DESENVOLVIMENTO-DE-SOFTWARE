<Window x:Class="Alunos.AdicionarAlunoGrupo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Alunos"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Title="Adicionar Aluno ao Grupo"
        Background="#F4F6F9" Height="589" Width="912">

    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Background" Value="#143d67"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="80">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Cabeçalho -->
            <RowDefinition Height="Auto"/>
            <!-- Filtros -->
            <RowDefinition Height="*"/>
            <!-- Tabela -->
            <RowDefinition Height="Auto"/>
            <!-- Botões -->
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Text="Adicionar Aluno ao Grupo"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="#143d67"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,30"/>

        <!-- Filtros -->
        <Grid Grid.Row="1" Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- Nome -->
            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <Label Content="Nome:" Width="60" VerticalAlignment="Center"/>
                <TextBox x:Name="tbNome"
                         Width="170"
                         Height="28"
                         VerticalAlignment="Center"
                         TextChanged="tbNome_TextChanged"/>
            </StackPanel>

            <!-- Espaço -->
            <Grid Grid.Column="1"/>

            <!-- Número -->
            <StackPanel Orientation="Horizontal" Grid.Column="2">
                <Label Content="Número:" Width="70" VerticalAlignment="Center"/>
                <TextBox x:Name="tbNumero"
                         Width="150"
                         Height="28"
                         VerticalAlignment="Center"
                         TextChanged="tbNumero_TextChanged"/>
            </StackPanel>
        </Grid>

        <!-- Tabela -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20"
               >
            <DataGrid x:Name="dataGridAlunos"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      RowHeight="36"
                      FontSize="14"
                      AlternatingRowBackground="#F0F2F5"
                      Background="White"
                      SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Selecionar" Binding="{Binding Selecionar}" Width="80"/>
                    <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="100"/>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Botões -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
            <Button x:Name="btnVoltarEditar"
                    Content="Voltar"
                    Style="{StaticResource ModernButtonStyle}"
                    Click="btnVoltarEditar_Click"/>
            <Button x:Name="btnGuardarEditar"
                    Content="Guardar"
                    Style="{StaticResource ModernButtonStyle}"
                    Click="btnGuardarEditar_Click"/>
        </StackPanel>
    </Grid>
</Window>
