<Window x:Class="Alunos.EditarGrupo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Editar Grupo"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="#F4F6F9" Height="561" Width="836">

    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Background" Value="#143d67"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="80">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Cabeçalho -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- Botões -->
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <TextBlock Text="Editar Grupo"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="#143d67"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,30"/>

        <!-- Tabela de Alunos -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20"
              >
            <DataGrid x:Name="dataGridEditar"
                      AutoGenerateColumns="False"
                      SelectionChanged="dataGridEditar_SelectionChanged"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      RowHeight="36"
                      FontSize="14"
                      AlternatingRowBackground="#F0F2F5"
                      Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="100"/>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                    <DataGridTemplateColumn Header="Apagar" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Apagar"
                                        Width="70"
                                        Height="28"
                                        Background="#b91c1c"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        BorderThickness="0"
                                        Click="BtnApagar_Click"
                                        HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Botões -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
            <Button x:Name="btnEditar3"
                    Content="Voltar"
                    Style="{StaticResource ModernButtonStyle}"
                    Click="btnEditar3_Click"/>
            <Button x:Name="btnEditar1"
                    Content="Adicionar"
                    Style="{StaticResource ModernButtonStyle}"
                    Click="btnEditar1_Click"/>
            <Button x:Name="btnSalvar"
                    Content="Guardar"
                    Style="{StaticResource ModernButtonStyle}"
                    Click="btnEditar4_Click"/>
        </StackPanel>
    </Grid>
</Window>
