<Window x:Class="Alunos.Estatatisticas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Title="Estatatisticas" Height="800" Width="800">

    <Grid Margin="20,20,20,52">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ComboBox no topo -->
        <ComboBox x:Name="cbAvaliacoes" Margin="0,0,0,10" Height="30" VerticalAlignment="Top"
                  SelectionChanged="cbAvaliacoes_SelectionChanged"/>

        <!-- Área do gráfico + botão -->
        <Grid Grid.Row="1" Margin="0,20,0,55">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Gráfico -->
            <oxy:PlotView x:Name="plotView" Grid.Row="0" Margin="0,0,0,10"/>

            <!-- Botão Voltar -->
            <Button x:Name="btnVoltar"
                    Content="Voltar"
                    Width="140" Height="40"
                    Style="{StaticResource RoundedButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Click="btnVoltar_Click"
                    Grid.Row="1" Margin="0,0,0,-89"/>
        </Grid>
    </Grid>
</Window>
