<Window x:Class="Alunos.Pauta"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Title="Pauta" Height="599" Width="900">

    <Grid Margin="10,10,10,80">

        <!-- Botão Voltar -->
        <Button x:Name="btnVoltar"
         Content="Voltar"
         Width="140" Height="40"
         Style="{StaticResource RoundedButtonStyle}"
         HorizontalAlignment="Right"
         VerticalAlignment="Bottom"
         Click="btnVoltar_Click" Margin="0,0,0,-65"/>

        <!-- DataGrid com visual moderno -->
        <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,10">
            <DataGrid x:Name="dgPauta"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      ItemsSource="{Binding Linhas}"
                      HeadersVisibility="Column"
                      RowHeight="36"
                      FontSize="14"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      AlternatingRowBackground="#F0F2F5"
                      Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nº" Binding="{Binding Numero}" Width="60"/>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="200"/>
                    <!-- As colunas das tarefas serão geradas no code-behind -->
                    <DataGridTextColumn Header="Avaliação Final" Binding="{Binding AvaliacaoFinal, StringFormat=F2}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</Window>
