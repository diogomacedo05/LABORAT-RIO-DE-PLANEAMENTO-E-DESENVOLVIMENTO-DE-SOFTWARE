<Window x:Class="Alunos.PautaeEstatistica"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pautas e Estatísticas"
        Height="500" Width="800"
        Background="#F0F2F5"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Estilo moderno para botões arredondados -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <!-- Título no topo -->
        <TextBlock Text="Menu de Gestão de Notas"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#333"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,40"/>

        <!-- StackPanel central com botões -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" >
            <Button Content="Pautas" Style="{StaticResource RoundedButtonStyle}" Click="btnPautas_Click"/>
            <Button Content="Estatísticas" Style="{StaticResource RoundedButtonStyle}" Click="btnEstatisticas_Click"/>
            <Button Content="Atribuir Notas" Style="{StaticResource RoundedButtonStyle}" Click="btnAtribuirNotas_Click"/>
        </StackPanel>

        <!-- Botão Voltar no canto inferior esquerdo -->
        <Button Content="Voltar"
                Style="{StaticResource RoundedButtonStyle}"
                Width="100"
                Height="35"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="10"
                Click="btnVoltar_Click"/>
    </Grid>
</Window>