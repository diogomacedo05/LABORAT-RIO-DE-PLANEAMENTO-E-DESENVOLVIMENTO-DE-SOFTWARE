<Window x:Class="Alunos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ResizeMode="CanResize"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Title="Página Principal" Height="450" Width="800"
        Background="#f4f6fa">

    <Window.Resources>
        <!-- Estilo para botões da barra lateral -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1e4d8f"/>
                    <Setter Property="Foreground" Value="#ffe082"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barra lateral com gradiente -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#143d67" Offset="0"/>
                    <GradientStop Color="#1e4d8f" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel x:Name="Sidebar" VerticalAlignment="Stretch">
                <Button x:Name="btnEditarListaAlunos" Content="Editar Lista Alunos"
                        Style="{StaticResource SidebarButtonStyle}" Margin="0,10,0,0"
                        Click="btnEditarListaAlunos_Click"/>
                <Button x:Name="btnEditarListaTarefas" Content="Editar Lista Tarefas"
                        Style="{StaticResource SidebarButtonStyle}" Margin="0,10,0,0"
                        Click="btnEditarListaTarefas_Click"/>
                <Button Content="Manutenção dos Grupos"
                        Style="{StaticResource SidebarButtonStyle}" Margin="0,10,0,0"
                        Click="btnManutencaoGrupos_Click"/>
                <Button x:Name="btnPautaEstatistica" Content="Pauta e Estatísticas"
                        Style="{StaticResource SidebarButtonStyle}" Margin="0,10,0,0"
                        Click="btnPautaEstatistica_Click"/>
                <StackPanel x:Name="SubMenuPautas" Visibility="Collapsed" Margin="10,0,0,0" >
                    <Button Content="Atribuir Notas" Height="40" Background="Transparent" Foreground="White"
                            FontSize="13" BorderThickness="0" Cursor="Hand" Click="btnAbrirNotas_Click"/>
                    <Button Content="Pautas" Height="40" Background="Transparent" Foreground="White"
                            FontSize="13" BorderThickness="0" Cursor="Hand" Click="btnAbrirPauta_Click"/>
                    <Button Content="Estatísticas" Height="40" Background="Transparent" Foreground="White"
                            FontSize="13" BorderThickness="0" Cursor="Hand" Click="btnEstatisticas_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Conteúdo principal -->
        <Grid Grid.Column="1">
            <!-- Gradiente de fundo (sem imagem) -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#f4f6fa" Offset="0"/>
                    <GradientStop Color="#e3eaf6" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Mensagem de boas-vindas no topo, centrada -->
            <TextBlock Text="Bem-vindo à aplicação!"
                       FontSize="44" FontWeight="Bold" Foreground="#143d67"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,40" Grid.Row="0"/>

            <!-- Foto, nome e email mais para cima e à esquerda -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="60,40,0,0">
                <!-- Foto de perfil com sombra -->
                <Ellipse x:Name="ImagemPerfil" Width="140" Height="140" Fill="Black"
                         Stroke="White" StrokeThickness="2" VerticalAlignment="Center">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.4"/>
                    </Ellipse.Effect>
                </Ellipse>
                <!-- Espaço entre foto e info -->
                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="32,0,0,0">
                    <Label x:Name="NomeLabel" Content="Nome:" FontSize="28" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Left"/>
                    <Label x:Name="EmailLabel" Content="Email:" FontSize="28" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Left"/>
                </StackPanel>
            </StackPanel>

            <!-- Botão editar perfil no canto superior direito -->
            <Button x:Name="btneditarperfil"
                    Content="Editar Perfil"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,30,30,0"
                    Padding="10,5"
                    FontWeight="Bold"
                    BorderThickness="2"
                    BorderBrush="#143d67"
                    Background="White"
                    Foreground="#143d67"
                    Width="150"
                    Height="40"
                    Click="btneditarperfil_Click"
                    Cursor="Hand"
                    Grid.Row="0">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border CornerRadius="20"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          RecognizesAccessKey="True"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#143d67"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#143d67"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</Window>
